+import { describe, expect, it } from 'vitest';
+
+import {
+  getBulkArchiveChangeSkillTemplate,
+  getContinueChangeSkillTemplate,
+  getExploreSkillTemplate,
+  getOpsxBulkArchiveCommandTemplate,
