+export function listUnknownChangeMetadataKeys(parsed: unknown): string[] {
+  if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    return [];
+  }
+  const known = new Set<string>(CHANGE_METADATA_KNOWN_KEYS);
