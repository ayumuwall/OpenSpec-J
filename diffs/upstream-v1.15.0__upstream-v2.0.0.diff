+ * Narrower than a full Markdown parser on purpose. Any numbered line ends the
+ * task, though a renderer would sometimes continue it: telling a wrapped
+ * `2. ...` from a sibling list item needs list nesting this parser does not
+ * track, and cutting a rare wrap short is safer than merging another item in.
+ */
+const TASK_TEXT_BREAK_PATTERN = new RegExp(
+  [
+    /^\s*$/,
+    /^\s*#{1,6}(?:\s|$)/,
+    /^\s*(?:```|~~~)/,
+    /^\s*>/,
+    /^\s*<[!?]/,
+    /^\s*(?:=+|-+)\s*$/,
+    /^\s*([-*_])(?:\s*\1){2,}\s*$/,
+    /^\s*(?:[-*+]|\d{1,9}[.)])(?:\s|$)/,
+  ]
+    .map((part) => part.source)
+    .join('|')
+);
+
+/** A trailing odd run of `\` is a Markdown hard line break; an even run is escaped text. */
+const HARD_BREAK_PATTERN = /(?<!\\)(?:\\\\)*\\$/;
+
+/**
+ * Same as `parseTaskLines`, with each task's line number.
+ *
+ * A task's text is its whole first paragraph, the way Markdown renders a
+ * wrapped list item: each following line that does not end the paragraph is
+ * joined onto the description with a single space. Reading the checkbox line
+ * alone cut a wrapped task off at its first newline, so `openspec instructions
+ * apply` handed the agent half a sentence while the count still looked right
+ * (#2227). A hard line break's trailing `\` is dropped before the join.
+ * Counting is unaffected: a continuation line is never itself a task.
+ */
+export function parseLocatedTaskLines(content: string): LocatedParsedTask[] {
+  const tasks: LocatedParsedTask[] = [];
+  let current: LocatedParsedTask | undefined;
 
-  for (const line of content.split('\n')) {
+  for (const [index, line] of content.split('\n').entries()) {
     const match = line.match(TASK_LINE_PATTERN);
     if (match) {
-      tasks.push({ done: (match[1] ?? '').toLowerCase() === 'x', description: match[2].trim() });
+      current = {
+        done: (match[1] ?? '').toLowerCase() === 'x',
+        description: match[2].trim(),
+        line: index + 1,
+      };
+      tasks.push(current);
+    } else if (current && !TASK_TEXT_BREAK_PATTERN.test(line)) {
+      const head = HARD_BREAK_PATTERN.test(current.description)
+        ? current.description.slice(0, -1).trimEnd()
+        : current.description;
+      current.description = head ? `${head} ${line.trim()}` : line.trim();
+    } else {
+      current = undefined;
     }
   }
 
