-      delete process.env.XDG_CONFIG_HOME;
-    } else {
-      process.env.XDG_CONFIG_HOME = previousXdgConfigHome;
-    }
-    await fs.rm(projectRoot, { recursive: true, force: true });
-    await fs.rm(configHome, { recursive: true, force: true });
