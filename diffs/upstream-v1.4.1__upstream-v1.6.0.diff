+
+function doctorStatusForError(
+  error: unknown,
+  code: string,
+  target: string,
+  fix?: string
+): StoreDiagnostic {
+  if (error instanceof StoreError) {
+    return error.diagnostic;
+  }
+
+  return makeStoreDiagnostic(
+    'error',
+    code,
+    error instanceof Error ? error.message : String(error),
+    {
+      target,
+      ...(fix ? { fix } : {}),
+    }
+  );
