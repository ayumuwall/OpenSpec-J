+  STORE_METADATA_DIR_NAME,
+  getStoreMetadataDir,
+  getStoreMetadataPath,
+  getStoreRegistryPath,
+  listStoreRegistryEntries,
+  readStoreRegistryState,
+  readOptionalStoreMetadataState,
+  resolveGitStoreBackendConfig,
