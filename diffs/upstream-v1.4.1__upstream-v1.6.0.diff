+function parseJsonContainer(value: string): unknown[] | Record<string, unknown> | undefined {
+  const trimmed = value.trim();
+  const looksLikeContainer =
+    (trimmed.startsWith('[') && trimmed.endsWith(']')) ||
+    (trimmed.startsWith('{') && trimmed.endsWith('}'));
+
+  if (!looksLikeContainer) {
+    return undefined;
+  }
+
