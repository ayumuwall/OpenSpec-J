+  classifyOpenSpecDir,
+  storePointerProblem,
+} from '../project-config.js';
+import {
+  ANCHORED_OPENSPEC_DIRS,
+  DIRECTORY_ANCHOR_FILE_NAME,
+  OPENSPEC_ROOT_DIR,
+  ensureOpenSpecRoot,
+  inspectOpenSpecRoot,
+  rollbackCreatedPaths,
+  type CreatedPathLedgerEntry,
+  type OpenSpecRootInspection,
+} from '../openspec-root.js';
