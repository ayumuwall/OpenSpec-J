@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+# Runs every CLI test (each test file that uses runCLI) against a standalone
+# binary instead of `node dist/cli/index.js`. Needs `pnpm install`.
+#
+#   bash scripts/binary/e2e.sh dist-bin/openspec-<asset>
+set -euo pipefail
+
+files=()
+while IFS= read -r file; do files+=("$file"); done < <(grep -rl 'runCLI' test | grep '\.test\.ts$' | sort)
+# Without files vitest would run the whole suite and prove nothing about $1.
+[ "${#files[@]}" -gt 0 ] || { echo "No CLI test files found" >&2; exit 1; }
+echo "Running ${#files[@]} CLI test files against $1"
+OPENSPEC_TEST_BINARY="$1" pnpm exec vitest run "${files[@]}"
diff --git a/scripts/binary/entry.mjs b/scripts/binary/entry.mjs
new file mode 100644
index 00000000..dee947b6
--- /dev/null
+++ b/scripts/binary/entry.mjs
@@ -0,0 +1,86 @@
+// Entry point of the standalone `openspec` binary built by build.mjs. The
+// binary has no package directory on disk, so the built-in schemas are
+// embedded at build time and written to a real directory before the CLI runs.
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { getGlobalDataDir } from '../../dist/core/global-config.js';
+import { setPackageSchemasDir } from '../../dist/core/artifact-graph/resolver.js';
+import { markStandaloneBinary } from '../../dist/core/version-check.js';
+
+// Replaced by build.mjs: { hash, files: { 'spec-driven/schema.yaml': '...' } }
+const { hash, files } = OPENSPEC_EMBEDDED_SCHEMAS;
+
+// Checked on every start, so a copy someone edited or partly deleted is
+// replaced instead of breaking the CLI until they find and remove it.
+function isIntact(dir) {
+  try {
+    return Object.entries(files).every(
+      ([relativePath, content]) => fs.readFileSync(path.join(dir, relativePath), 'utf8') === content
+    );
+  } catch {
+    return false;
+  }
+}
+
+function writeFiles(dir) {
+  for (const [relativePath, content] of Object.entries(files)) {
+    const file = path.join(dir, relativePath);
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, content);
+  }
+  return dir;
+}
+
+// Keyed by content and created only by an atomic rename of a fully written
+// copy, so concurrent first runs never see a half-written directory.
+function extractToDataDir() {
+  const dir = path.join(getGlobalDataDir(), 'binary-schemas', hash);
+  if (isIntact(dir)) return dir;
+
+  fs.mkdirSync(path.dirname(dir), { recursive: true });
+  const tmp = writeFiles(fs.mkdtempSync(`${dir}.tmp-`));
+  if (fs.existsSync(dir)) {
+    // A rename cannot replace a non-empty directory, so move the damaged
+    // copy aside first. Another process may already have done it.
+    try {
+      fs.renameSync(dir, `${tmp}-stale`);
+    } catch {}
+    fs.rmSync(`${tmp}-stale`, { recursive: true, force: true });
+  }
+  try {
+    fs.renameSync(tmp, dir);
+  } catch (error) {
+    fs.rmSync(tmp, { recursive: true, force: true });
+    // Another process finished first; its copy is identical.
+    if (!isIntact(dir)) throw error;
+  }
+  return dir;
+}
+
+function extractSchemas() {
+  try {
+    return extractToDataDir();
+  } catch {
+    // Read-only home, locked-down CI: use a private copy for this run only.
+    const dir = writeFiles(fs.mkdtempSync(path.join(os.tmpdir(), 'openspec-schemas-')));
+    process.on('exit', () => fs.rmSync(dir, { recursive: true, force: true }));
+    return dir;
+  }
+}
+
+markStandaloneBinary(process.execPath);
+
+let schemasDir;
+setPackageSchemasDir(() => {
+  try {
+    schemasDir ??= extractSchemas();
+  } catch (error) {
+    throw new Error(`Could not write the built-in schemas to disk: ${error.message}`);
+  }
+  return schemasDir;
+});
+// No runCli() call: process.argv[1] and import.meta.url are both fixed at
+// build time to the same virtual path, so the CLI's "run when executed
+// directly" check always fires, whatever the user renames the binary to.
+await import('../../dist/cli/index.js');
diff --git a/scripts/binary/install-check.sh b/scripts/binary/install-check.sh
new file mode 100755
index 00000000..df29c581
--- /dev/null
+++ b/scripts/binary/install-check.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+# Checks `openspec install` against a release served at OPENSPEC_DOWNLOAD_URL:
+# run from the Node build, as an npm user would, and by the binary on itself,
+# which reinstalls in place. Needs `pnpm build`.
+#
+#   OPENSPEC_DOWNLOAD_URL=http://127.0.0.1:8766 bash scripts/binary/install-check.sh dist-bin/openspec-<asset>
+set -euo pipefail
+
+asset=$1
+ext=""
+case "$asset" in *.exe) ext=".exe" ;; esac
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+export XDG_CONFIG_HOME="$work/config" XDG_DATA_HOME="$work/data" OPENSPEC_TELEMETRY=0 OPENSPEC_NO_UPDATE_CHECK=1
+fail() { echo "FAIL: $*" >&2; exit 1; }
+
+# 1. From the Node build, into a fresh folder.
+OPENSPEC_INSTALL_DIR="$work/from-node" node bin/openspec.js install
+cmp "$work/from-node/openspec$ext" "$asset" || fail "install from Node wrote the wrong file"
+"$work/from-node/openspec$ext" version | grep -q '(standalone)' || fail "installed copy is not standalone"
+
+# 2. The binary replacing itself where it is, under its own (custom) name.
+# Twice: on Windows the running exe is set aside, and the next run removes it.
+mkdir "$work/self"
+self="$work/self/my-openspec$ext"
+cp "$asset" "$self"
+for run in 1 2; do
+  out=$(env -u OPENSPEC_INSTALL_DIR -u OPENSPEC_INSTALL_NAME "$self" install 2>&1) || fail "self-install run $run failed: $out"
+  case "$out" in *"Installed openspec"*"my-openspec$ext"*) ;; *) fail "self-install run $run did not replace itself: $out" ;; esac
+  cmp "$self" "$asset" || fail "self-install run $run wrote the wrong file"
+done
+"$self" version | grep -q '(standalone)' || fail "reinstalled copy is not standalone"
+leftovers=$(find "$work/self" -mindepth 1 -maxdepth 1 ! -name "my-openspec$ext" | wc -l | tr -d ' ')
+[ "$leftovers" -le 1 ] || fail "files pile up next to the binary: $(ls -A "$work/self")"
+
+echo "OK: openspec install ($asset)"
